# Local-only backend mode. Copy to .env and replace every <...> placeholder.
APP_MODE=local_autonomous
APP_ENV=local
APP_TIMEZONE=America/Chicago
LOCAL_USER_ID=local-autonomous-owner
PUBLIC_BASE_URL=https://your-mcp-host.example
FRONTEND_ORIGIN=
CHATGPT_RETURN_URL=https://chatgpt.com

MCP_REQUIRE_OAUTH=false
LOCAL_MCP_API_TOKEN=<generate-a-long-random-secret>
ALLOW_UNAUTHENTICATED_PUBLIC_MCP=false

DATABASE_URL=sqlite:///storage/local_autonomous.db
BROKER_SECRET_KEY=<generate-a-long-random-encryption-secret>
MARKET_DATA_PROVIDER=tradelocker
ALLOW_ENV_BROKER_FALLBACK=true

TRADELOCKER_ENVIRONMENT=demo
TRADELOCKER_BASE_URL=https://demo.tradelocker.com/backend-api
TRADELOCKER_EMAIL=<broker-login-email>
TRADELOCKER_PASSWORD=<broker-login-password>
TRADELOCKER_SERVER=<broker-server>
TRADELOCKER_ACCOUNT_ID=<exact-selected-account-id>
# Optional consistency assertion. Leave blank to discover TradeLocker's internal accNum.
TRADELOCKER_ACCOUNT_NUMBER=

OPENAI_API_KEY=<openai-api-key>
AUTONOMOUS_DECISION_PROVIDER=openai
AUTONOMOUS_DECISION_MODEL=<accessible-api-model-id>
AUTONOMOUS_STRATEGY_NAME=whole_market_multi_timeframe_v1
AUTONOMOUS_STRATEGY_PROMPT=Scan eligible TradeLocker markets and return no_trade unless every setup and safety requirement is met.
AUTONOMOUS_STRATEGY_JSON={"version":1,"ranking":{"return_top_candidates":5,"maximum_executable_candidates":1},"setups":["trend_continuation","breakout_retest","confirmed_reversal"]}
AUTONOMOUS_MAX_HISTORY_REQUESTS_PER_CYCLE=20
AUTONOMOUS_HTF_CANDIDATE_LIMIT=20
AUTONOMOUS_LTF_CANDIDATE_LIMIT=8
AUTONOMOUS_ENTRY_CANDIDATE_LIMIT=3

AUTONOMOUS_ALLOWED_ASSET_CLASSES=forex,metals,energies,indices,crypto
AUTONOMOUS_ALLOWED_SYMBOLS=
AUTONOMOUS_BLOCKED_SYMBOLS=
AUTONOMOUS_ALLOWED_DIRECTIONS=long,short
AUTONOMOUS_SCAN_TIMEFRAMES=5m,15m,1h,4h,1d
AUTONOMOUS_CONFIRMATION_TIMEFRAMES=1h,4h,1d
AUTONOMOUS_MINIMUM_CONFIDENCE=0.80
AUTONOMOUS_MINIMUM_RISK_REWARD=2.0
AUTONOMOUS_RISK_PER_TRADE_PERCENT=0.25
AUTONOMOUS_MAX_TOTAL_RISK_PERCENT=1.00
AUTONOMOUS_MAX_DAILY_LOSS_PERCENT=1.50
AUTONOMOUS_MAX_DRAWDOWN_PERCENT=5.00
AUTONOMOUS_MAX_OPEN_POSITIONS=3
AUTONOMOUS_MAX_OPEN_POSITIONS_PER_SYMBOL=1
AUTONOMOUS_MAX_TRADES_PER_DAY=5
AUTONOMOUS_COOLDOWN_MINUTES=30
AUTONOMOUS_REQUIRE_STOP_LOSS=true
AUTONOMOUS_REQUIRE_TAKE_PROFIT=true
AUTONOMOUS_ALLOW_OVERNIGHT=false
AUTONOMOUS_ALLOW_WEEKEND_CRYPTO=false
AUTONOMOUS_MAX_SPREAD_PIPS=3.0
AUTONOMOUS_NEWS_BLACKOUT_MINUTES=30
AUTONOMOUS_QUOTE_MAX_AGE_SECONDS=30
AUTONOMOUS_PRICE_TOLERANCE_PERCENT=0.25
AUTONOMOUS_SNAPSHOT_TTL_SECONDS=60
AUTONOMOUS_PREVIEW_TTL_SECONDS=60
AUTONOMOUS_DECISION_TIMEOUT_SECONDS=30
AUTONOMOUS_DECISION_MAX_RETRIES=1
AUTONOMOUS_DECISION_MAX_INPUT_CHARS=80000

# Execute one decision cycle on every 15-minute candle boundary.
AUTONOMOUS_SCHEDULE_INTERVAL_MINUTES=15
AUTONOMOUS_SCHEDULE_START_TIME=00:00
AUTONOMOUS_SCHEDULE_END_TIME=23:45
AUTONOMOUS_SCHEDULE_DAYS=monday,tuesday,wednesday,thursday,friday,saturday,sunday
AUTONOMOUS_SCHEDULE_MARKET_AWARE=true

AUTONOMOUS_SCHEDULER_EMBEDDED=true
AUTONOMOUS_SCHEDULER_REQUIRED_FOR_READINESS=true
AUTONOMOUS_SCHEDULER_POLL_SECONDS=30
AUTONOMOUS_SCHEDULER_LEASE_SECONDS=180
AUTONOMOUS_SCHEDULER_BATCH_SIZE=20
AUTONOMOUS_SCHEDULER_MAX_RETRIES=2
AUTONOMOUS_SCHEDULER_RETRY_BASE_SECONDS=30
AUTONOMOUS_SCHEDULER_RETRY_CAP_SECONDS=300
AUTONOMOUS_SCHEDULER_HEARTBEAT_STALE_SECONDS=120

# Start safely. Change the first two only after preview verification; kill switch wins.
LIVE_TRADING_ENABLED=false
AUTONOMOUS_EXECUTION_ENABLED=false
AUTONOMOUS_POSITION_MANAGEMENT_ENABLED=true
AUTONOMOUS_CLOSE_ENABLED=true
AUTONOMOUS_PARTIAL_CLOSE_ENABLED=true
AUTONOMOUS_STOP_MODIFICATION_ENABLED=true
AUTONOMOUS_TAKE_PROFIT_MODIFICATION_ENABLED=true
AUTONOMOUS_BREAK_EVEN_ENABLED=true
AUTONOMOUS_BREAK_EVEN_BUFFER_PIPS=1.0
AUTONOMOUS_TRAILING_STOP_ENABLED=false
AUTONOMOUS_TRAILING_DISTANCE_ATR_MULTIPLIER=1.5
AUTONOMOUS_TRAILING_MIN_STEP_PIPS=5
AUTONOMOUS_CANCEL_PENDING_ENABLED=true
AUTONOMOUS_EMERGENCY_EXIT_ENABLED=true
AUTONOMOUS_MANAGEMENT_DECISION_MAX_AGE_SECONDS=60
AUTONOMOUS_MANAGEMENT_LEASE_SECONDS=120
KILL_SWITCH_ENABLED=true
ALLOW_REMOTE_ACCOUNT_SWITCHING=false
ALLOW_REMOTE_CREDENTIAL_CHANGES=false
ALLOW_REMOTE_STRATEGY_CHANGES=false
ALLOW_REMOTE_RISK_CHANGES=false

FINNHUB_ENABLED=false
FINNHUB_API_KEY=
FINNHUB_BASE_URL=https://finnhub.io/api/v1
FINNHUB_TIMEOUT_SECONDS=15
FINNHUB_MAX_RETRIES=2
FINNHUB_CACHE_TTL_SECONDS=300
FRED_ENABLED=false
FRED_API_KEY=
FRED_BASE_URL=https://api.stlouisfed.org/fred
FRED_TIMEOUT_SECONDS=15
FRED_MAX_RETRIES=2
FRED_CACHE_TTL_SECONDS=3600
MACRO_CATALOG_JSON={}

MARKET_DATA_DEFAULT_CANDLES=300
MARKET_DATA_MAX_RESPONSE_CANDLES=2000
MARKET_DATA_MAX_RETRIEVAL_CANDLES=10000
MARKET_DATA_MAX_PAGES=50
MARKET_SERIES_CACHE_TTL_SECONDS=600
MARKET_SERIES_CACHE_MAX_ITEMS=100
TRADELOCKER_CONFIG_CACHE_TTL_SECONDS=900
TRADELOCKER_CANDLE_CACHE_GRACE_SECONDS=30
TRADELOCKER_CANDLE_CACHE_MAX_STALE_SECONDS=86400
TRADELOCKER_CANDLE_CACHE_MAX_ENTRIES=1000
TRADELOCKER_RATE_LIMIT_MAX_RETRIES=2
TRADELOCKER_RATE_LIMIT_MAX_BACKOFF_SECONDS=8
TRADELOCKER_RATE_LIMIT_MIN_INTERVAL_SECONDS=0.35
